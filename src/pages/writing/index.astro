---
import { getCollection } from 'astro:content';
import Navbar from '../../components/Navbar.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import Logo from '../../assets/rohan_logo.svg';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Group by year -> month
const grouped = posts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  const month = post.data.date.toLocaleString('default', { month: 'long' , timezone: 'UTC'});
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];
  acc[year][month].push(post);
  return acc;
}, {} as Record<number, Record<string, typeof posts>>);

const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        max-width: 400px;
        margin: 0 auto;
        padding: 2rem;
      }
      h1 {
        font-weight: 700;
        text-align: center;
        letter-spacing: .05em;
      }
      .logo {
        display: block;
        margin: 2rem auto 0;
        width: 300px;
        height: auto;
      }

      .year {
        font-weight: 700;
        font-size: 1rem;
        margin: 3rem 0 0.5rem 0rem;
      }

      .month {
        font-weight: 700;
        font-size: 0.95rem;
        margin: 1rem 0 0.25rem 3rem;
      }

      .post-row {
        display: flex;
        gap: 2rem;
        padding: 0.2rem 0;
      }

      .day {
        font-weight: 700;
        min-width: 2rem;
        text-align: right;
        margin-left: 3rem;
      }

      .post-row a {
        color: inherit;
        text-decoration: none;
      }

      .post-row a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <Navbar />    
    <div class="logo">
      <Logo />
    </div>
    <main>
      <h1>Writing</h1>
      {years.map(year => (
        <div>
          <div class="year">{year}</div>
          {Object.keys(grouped[year]).map(month => (
            <div>
              <div class="month">{month}</div>
              {grouped[year][month].map(post => (
                <div class="post-row">
                  <span class="day">{post.data.date.getUTCDate()}</span>
                  <a href={`/writing/${post.slug}`}>{post.data.title}</a>
                </div>
              ))}
            </div>
          ))}
        </div>
      ))}
    </main>
    <Footer />
  </body>
</html>